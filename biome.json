{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!.claude/skills", "!**/*.php"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        "noDuplicateMapKeys": "on",
        "noYamlBooleanKeys": "on"
      },
      "performance": {
        "noBarrelFile": "warn"
      },
      "style": {
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noImplicitBoolean": "error",
        "noInferrableTypes": "error",
        "noShoutyConstants": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "warn",
        "useCollapsedIf": "warn",
        "useDefaultSwitchClause": "error",
        "useDestructuring": "warn",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "warn"
      },
      "security": {
        "noSecrets": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noImportCycles": "warn"
      },
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on"
      }
    }
  }
}
