APP_NAME=thesis-dms
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Budapest
APP_URL=http://localhost:8000

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=16

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=info@zephyr.co.hu
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@zephyr.co.hu
MAIL_FROM_NAME="Zephyr Bt."
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Zephyr Bt."

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=zephyrco_webporta
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_hu_0900_ai_ci
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=webporta.zeprhyr.co.hu
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
